# Copy to .env to override defaults. Every setting is optional for local development.

# --- Service ---------------------------------------------------------------
# Database. Default: a SQLite file at api/fraud.db. PostgreSQL example:
# FRAUD_DATABASE_URL=postgresql+psycopg://fraud:password@localhost:5432/fraud

# Secret used to sign login tokens. Set a long random value outside local development.
# FRAUD_JWT_SECRET=

# Demo accounts created on first start (change the passwords for anything public).
# FRAUD_ADMIN_USERNAME=admin
# FRAUD_ADMIN_PASSWORD=admin123
# FRAUD_ANALYST_USERNAME=analyst
# FRAUD_ANALYST_PASSWORD=analyst123

# Which registered model to serve (default: latest version of fraud_scorer).
# FRAUD_MODEL_NAME=fraud_scorer
# FRAUD_MODEL_VERSION=v2

# Days a label must age before retraining may use it.
# FRAUD_LABEL_MATURITY_DAYS=2

# When the model's newest training labels are older than this, transactions it
# would allow are sent to review if their anomaly score is very high.
# FRAUD_MAX_LABEL_AGE_DAYS=14

# Requests per minute per client address (0 disables).
# FRAUD_RATE_LIMIT_PER_MINUTE=1200

# Browser origins allowed to call the API.
# FRAUD_CORS_ORIGINS=http://localhost:5173

# --- Data and training scripts ----------------------------------------------
# FRAUD_RAW_PATH=data/raw/transaction_data.csv
# FRAUD_FEATURES_PATH=data/processed/paysim_features.parquet
